# Copy to /etc/auralis-discord-bot.env (systemd) or discord-bot/deploy/.env (Docker) and fill in.
# Never commit the real file: it holds the bot's login.
DISCORD_BOT_TOKEN=paste-the-token-here

# Heap for the JVM. 768 MB suits a 1 GB server; raise it on bigger ones.
# ExitOnOutOfMemoryError makes the service restart instead of limping on.
JAVA_OPTS=-Xms128m -Xmx768m -XX:+ExitOnOutOfMemoryError
