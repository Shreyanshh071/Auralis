diff --git a/windows/core/src/desktopTest/kotlin/com/auralis/music/data/sync/AccountPreferencesSyncTest.kt b/windows/core/src/desktopTest/kotlin/com/auralis/music/data/sync/AccountPreferencesSyncTest.kt
index 5add9e69..80afbcfd 100644
--- a/windows/core/src/desktopTest/kotlin/com/auralis/music/data/sync/AccountPreferencesSyncTest.kt
+++ b/windows/core/src/desktopTest/kotlin/com/auralis/music/data/sync/AccountPreferencesSyncTest.kt
@@ -35,6 +35,43 @@ class AccountPreferencesSyncTest {
     private fun engine(local: Local, cloud: Cloud, journal: Journal = Journal(), device: String = "phone") =
         AccountPreferencesSync(local, cloud, journal, device, now = { time }, pollMs = 1000)
 
+    @Test fun anIdleAppReadsTheAccountOncePerQuarterHourNotEveryHalfMinute() = runBlocking {
+        val local = Local(); val cloud = Cloud()
+        // The production default, stepped every second as both apps do.
+        val sync = AccountPreferencesSync(local, cloud, Journal(), "phone", now = { time })
+        sync.step("user")
+        assertEquals(1, cloud.calls, "one pull at start")
+        repeat(14 * 60) { time += 1000; sync.step("user") }
+        assertEquals(1, cloud.calls, "no reads while idle for 14 minutes (was 28)")
+        repeat(60) { time += 1000; sync.step("user") }
+        assertEquals(2, cloud.calls, "one background check at 15 minutes")
+        // An edit still goes up within about a second.
+        local.change("a.lyrics_animation", "Fade")
+        repeat(2) { time += 1000; sync.step("user") }
+        assertEquals(3, cloud.calls)
+        assertEquals("Fade", cloud.accounts["user"]?.get("a.lyrics_animation")?.value)
+        assertEquals(AccountPreferencesSync.DEFAULT_POLL_MS, 15 * 60_000L)
+    }
+
+    @Test fun failuresBackOffToFifteenMinutesInsteadOfRetryingEveryFifteenSeconds() = runBlocking {
+        val local = Local(); val cloud = Cloud(); val sync = engine(local, cloud)
+        sync.step("user")
+        cloud.offline = true
+        local.change("a.lyrics_animation", "Fade")
+        val attempts = mutableListOf<Long>()
+        var calls = cloud.calls
+        repeat(60 * 60) {
+            time += 1000; sync.step("user")
+            if (cloud.calls != calls) { attempts += time; calls = cloud.calls }
+        }
+        val gaps = attempts.zipWithNext { a, b -> (b - a) / 1000 }
+        assertEquals(listOf(15L, 30L, 60L, 120L, 240L, 480L, 900L), gaps.take(7), "gaps in seconds: $gaps")
+        assertTrue(attempts.size <= 12, "an hour offline makes ${attempts.size} attempts, not 240")
+        cloud.offline = false
+        repeat(900) { time += 1000; sync.step("user") }
+        assertEquals("Fade", cloud.accounts["user"]?.get("a.lyrics_animation")?.value, "the edit is not lost")
+    }
+
     @Test fun freshSignInRestoresSavedLyricsAndMiniPlayerInsteadOfUploadingDefaults() = runBlocking {
         val cloud = Cloud()
         val phone = Local().apply { change("a.lyrics_animation", "Spicy Lyrics"); change("a.mini_player_bg_style", "Live Mesh") }
