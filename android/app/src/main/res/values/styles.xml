<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for Jetpack Compose with immersive edge-to-edge support -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="@android:style/Theme.Material.NoActionBar">
        <!-- Transparent mark on the phone's light/dark launch background. -->
        <item name="android:windowBackground">@drawable/launch_screen</item>
        <item name="android:windowLightStatusBar">@bool/launch_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/launch_light_system_bars</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
