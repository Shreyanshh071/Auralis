# Auralis environment configuration
#
# Copy this file to `.env` and fill in the values, then restart the dev server.
#   cp .env.example .env
#
# `.env` is git-ignored. These Firebase web values are not secrets — they are
# shipped in the client bundle — but they are project-specific, so they are read
# from the environment instead of being hardcoded in `src/services/firebase.ts`.
#
# Where to find them:
#   Firebase console -> Project settings -> General
#     -> "Your apps" -> Web app -> SDK setup and configuration -> Config
#
# If a Web app does not exist yet, create one ("Add app" -> Web). The Android app
# registration is separate and is configured by `android/app/google-services.json`.

# --- Required: without all four, sign-in and cloud sync are disabled and the app
# --- reports that instead of silently failing. Everything else keeps working.

# firebaseConfig.apiKey
VITE_FIREBASE_API_KEY=

# firebaseConfig.authDomain, e.g. my-project.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=

# firebaseConfig.projectId
VITE_FIREBASE_PROJECT_ID=

# firebaseConfig.appId.
# MUST be the Web app ID and look like 1:<sender>:web:<hash>
# An Android app ID (1:<sender>:android:<hash>) will NOT work with the JS SDK.
VITE_FIREBASE_APP_ID=

# --- Optional ---

# firebaseConfig.storageBucket. Only needed if Cloud Storage is used.
VITE_FIREBASE_STORAGE_BUCKET=

# firebaseConfig.messagingSenderId. Only needed for Cloud Messaging.
VITE_FIREBASE_MESSAGING_SENDER_ID=

# OAuth 2.0 Web client ID. Only needed by a native Google Sign-In plugin.
# Google Cloud console -> APIs & Services -> Credentials.
VITE_GOOGLE_CLIENT_ID=

# --- YouTube Sync (Optional) ---
#
# To enable YouTube account sync (import playlists, liked songs, subscriptions),
# the following manual setup is required in Google Cloud Console:
#
# 1. Go to APIs & Services -> Library
# 2. Search for and enable "YouTube Data API v3"
# 3. Go to APIs & Services -> OAuth consent screen
# 4. Add scope: https://www.googleapis.com/auth/youtube.readonly
# 5. Go to APIs & Services -> Credentials
# 6. Edit the OAuth 2.0 Web Client
# 7. Add authorized redirect URIs for your app domain(s)
#
# The YouTube API key below is optional (the app uses the OAuth access token
# from Firebase Auth to authenticate API calls).
VITE_YOUTUBE_API_KEY=
